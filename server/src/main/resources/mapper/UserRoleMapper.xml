<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.club.mapper.UserRoleMapper">

  <resultMap id="UserRoleRelationMap" type="com.example.club.domain.UserRoleRelation">
    <id column="user_id" property="userId"/>
    <result column="role_id" property="roleId"/>
    <result column="role_code" property="roleCode"/>
    <result column="role_name" property="roleName"/>
    <result column="role_status" property="roleStatus"/>
  </resultMap>

  <insert id="insert" parameterType="com.example.club.domain.UserRole" useGeneratedKeys="true" keyProperty="id">
    insert into user_roles (user_id, role_id)
    values (#{userId}, #{roleId})
  </insert>

  <insert id="insertBatch">
    insert into user_roles (user_id, role_id)
    values
    <foreach collection="roleIds" item="roleId" separator=",">
      (#{userId}, #{roleId})
    </foreach>
  </insert>

  <delete id="deleteByUserId">
    delete from user_roles where user_id = #{userId}
  </delete>

  <select id="countByRoleId" resultType="long">
    select count(1) from user_roles where role_id = #{roleId}
  </select>

  <select id="selectRoleIdsByUserId" resultType="long">
    select role_id from user_roles where user_id = #{userId}
  </select>

  <select id="selectRoleInfoByUserIds" resultMap="UserRoleRelationMap">
    select ur.user_id, r.id as role_id, r.role_code, r.role_name, r.status as role_status
    from user_roles ur
    join roles r on r.id = ur.role_id
    where ur.user_id in
    <foreach collection="userIds" item="userId" open="(" separator="," close=")">
      #{userId}
    </foreach>
  </select>

  <delete id="deleteByUserIdAndRoleId">
    delete from user_roles where user_id = #{userId} and role_id = #{roleId}
  </delete>

</mapper>


